<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_lazada_categories" model="ir.actions.act_window">
            <field name="name">Woo Categories</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.category</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('is_woo', '=', True)]</field>
            <field name="context">
                {
                    'default_is_woo': True,
                    'create': 0,
                    'delete': 0,
                    'edit': 0
                }
            </field>
        </record>

        <record id="woo_product_category_inherit_tree_view" model="ir.ui.view">
            <field name="name">woo_product_category_inherit_tree_view</field>
            <field name="model">product.category</field>
            <field name="inherit_id" ref="product.product_category_list_view"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='display_name']" position="after">
                    <field name="lazada_category_id"/>
                    <field name="is_leaf"/>
                </xpath>

            </field>
        </record>

        <menuitem id="menu_lazada_categories"
                  name="Woo Product Categories"
                  parent="corsiva_connector.menu_corsiva_connector_configuration"
                  action="action_lazada_categories"
                  sequence="20"/>

    </data>
</odoo>