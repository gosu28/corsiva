<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="shopee_connector_res_config_settings_inherit_form_view" model="ir.ui.view">
            <field name="name">shopee_connector_res_config_settings_inherit_form_view</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="corsiva_shopee" string="Shopee" data-key="corsiva_shopee">
                        <h2>Shopee Configuration</h2>
                        <div class="row mt16 o_settings_container" name="shopee_connector_setting">
                            <div class="o_setting_box col-12 col-lg-12">
                                <div class="o_setting_right_pane">
                                    <div class="row mt16">
                                        <label class="o_form_label col-4 o_light_label" for="partner_id"/>
                                        <field name="partner_id"/>
                                    </div>
                                    <div class="row mt16">
                                        <label class="o_form_label col-4 o_light_label" for="partner_key"/>
                                        <field name="partner_key"/>
                                    </div>
                                    <div class="row mt16">
                                        <label class="o_form_label col-4 o_light_label" for="redirect_url"/>
                                        <field name="redirect_url"/>
                                    </div>
                                    <div class="row mt16">
                                        <label class="o_form_label col-4 o_light_label" for="authen_url"/>
                                        <field name="authen_url"/>
                                    </div>
                                    <div class="mt-5">
                                        <field name="shopee_synced_master_data" invisible="1"/>
                                        <button name='action_shopee_synchronize_master_data'
                                                icon="fa-arrow-right"
                                                type="object"
                                                string="Synchronize Master Data"
                                                class="btn-link"
                                                attrs="{'invisible': [('shopee_synced_master_data', '!=', False)]}"
                                                confirm="This will synchronize all master data of shopee?"
                                        />
                                        <span attrs="{'invisible': [('shopee_synced_master_data', '=', False)]}">
                                            <i class="fa fa-fw fa-check" role="img" style="color: #1e9f75"/>
                                            <span class="d-none d-md-inline" style="color:gray"> Master Data Synced</span>
                                        </span>
                                    </div>
                                    <div class="row mt-5">
                                        <div class="col-3">
                                            <button name="action_shopee_authorize"
                                                    type="object"
                                                    string="Authorization"
                                                    class="oe_highlight"
                                            />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>

            </field>
        </record>
        <record id="action_shopee_connector_config_settings" model="ir.actions.act_window">
            <field name="name">Shopee Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_id" ref="base.res_config_settings_view_form"/>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'corsiva_shopee'}</field>
        </record>

        <menuitem id="shopee_connector_menu_root"
                  name="Shopee"
                  web_icon="corsiva_shopee,static/description/icon.png"
                  sequence="99"/>
    </data>
</odoo>