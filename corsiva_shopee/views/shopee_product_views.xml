<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="product_template_inherit_form_view" model="ir.ui.view">
            <field name="name">product.template.inherit.form.view</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//button[@name='action_update_quantity_on_hand']" position="after">
                    <button string="Push Shopee" type="object" name="action_push_product_to_shopee"
                            attrs="{'invisible': ['|', ('is_shopee_product', '=', False), ('shopee_synced_ok', '=', True)]}"/>
                </xpath>

                <xpath expr="//span[@class='d-inline-block']" position="after">
                    <span class="d-inline-block">
                        <field name="is_shopee_product" attrs="{'readonly': [('shopee_synced_ok', '=', True)]}"/>
                        <label for="is_shopee_product"/>
                    </span>
                </xpath>

                <xpath expr="//page[last()]" position="after">
                    <page name="shopee_pages" string="Shopee">
                        <group>
                            <field name="shopee_category_id" options="{'no_create': True, 'no_open': True}" domain="[('shopee_leaf_cate', '=', True)]"/>
                            <field name="logistic_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="shopee_item_id" invisible="0" string="Shopee ID" readonly="1"/>
                            <field name="shopee_synced_ok" invisible="1"/>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>

    </data>
</odoo>