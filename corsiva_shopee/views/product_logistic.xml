<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record id="corsiva_product_logistic_view_form" model="ir.ui.view">
            <field name="name">corsiva_product_logistic_view_form</field>
            <field name="model">product.logistic</field>
            <field name="arch" type="xml">
                <form string="corsiva_product_logistic_form" create="0" delete="0" edit="0">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="shopee_logistic_id"/>
                            <field name="size_id"/>
                            <field name="line_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="size_id"/>
                                    <field name="default_price"/>
                                </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="corsiva_product_logistic_view_tree" model="ir.ui.view">
            <field name="name">corsiva_product_logistic_view_tree</field>
            <field name="model">product.logistic</field>
            <field name="arch" type="xml">
                <tree string="corsiva_product_logistic_tree" create="0" delete="0" edit="0">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="corsiva_product_logistic_action" model="ir.actions.act_window">
            <field name="name">Logistic</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.logistic</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_product_logistic"
                  name="Logistic"
                  parent="corsiva_setup.menu_e_commerce_configuration"
                  action="corsiva_product_logistic_action"
                  sequence="30"/>

    </data>
</odoo>